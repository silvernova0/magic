datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  createdAt   DateTime     @default(now())
  decks       Deck[]
}

model Deck {
  id          String     @id @default(cuid())
  name        String
  description String?
  theme       String
  powerLevel  String
  decklist    Json
  status      DeckStatus @default(GENERATED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  userId      String
}

enum DeckStatus {
  GENERATED
  SAVED
}

model DeckCache {
  id        String   @id @default(cuid())
  url       String   @unique
  source    String
  data      Json
  fetchedAt DateTime @default(now())
}