datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  // @db.Text
  access_token       String?  // @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  // @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          UserRole  @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  decks         Deck[]
  cards         UserCard[]
  feedback      Feedback[]
}

enum UserRole {
  USER
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deck {
  id          String     @id @default(cuid())
  name        String
  description String?
  theme       String
  powerLevel  String
  decklist    Json
  status      DeckStatus @default(GENERATED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  userId      String
}

enum DeckStatus {
  GENERATED
  SAVED
  IMPORTED
}

model DeckCache {
  id        String   @id @default(cuid())
  url       String   @unique
  source    String
  data      Json
  fetchedAt DateTime @default(now())
}

model UserCard {
  id         String   @id @default(cuid())
  name       String
  manaCost   String
  cmc        Float
  colors     String
  type_line  String
  oracleText String?
  power      String?
  toughness  String?
  setName    String
  rarity     String
  imageUrl   String?
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  userId     String
}

// ============================================
// COMPREHENSIVE CARD DATABASE (from Scryfall)
// ============================================

model Card {
  id              String   @id // Scryfall ID
  oracleId        String?  // Oracle ID for all printings
  name            String
  manaCost        String?
  cmc             Float
  colors          String   // JSON array of colors
  colorIdentity   String   // JSON array for Commander
  typeLine        String
  oracleText      String?
  power           String?
  toughness       String?
  loyalty         String?
  keywords        String?  // JSON array
  legalities      String   // JSON object {standard, modern, commander, etc}
  rarity          String
  setCode         String
  setName         String
  collectorNumber String
  imageUris       String?  // JSON object with image URLs
  prices          String?  // JSON object with price data
  edhrecRank      Int?
  edhrecSaltiness Float?
  tags            String?  // JSON array of tags (ramp, removal, card_draw, etc.)
  artist          String?
  flavorText      String?
  releasedAt      DateTime?
  isCommander     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  commanderDecks  CommanderDeck[]
  synergies       CardSynergy[]    @relation("CardSynergies")
  combos          ComboCard[]

  @@index([name])
  @@index([oracleId])
  @@index([colors])
  @@index([typeLine])
  @@index([isCommander])
}

// ============================================
// COMMANDER & DECK DATA
// ============================================

model CommanderDeck {
  id           String   @id @default(cuid())
  name         String
  commander    String   // Commander name
  commanderId  String?  // Link to Card
  colors       String   // JSON array
  theme        String?
  powerLevel   Int?     // 1-5 bracket
  source       String   // "edhrec", "mtgtop8", "moxfield"
  sourceUrl    String?
  decklist     String   // JSON array of card names
  popularity   Int?     // Number of decks/views
  winRate      Float?
  avgTurns     Float?
  scrapedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  card Card? @relation(fields: [commanderId], references: [id])

  @@index([commander])
  @@index([source])
  @@index([powerLevel])
}

// ============================================
// SYNERGIES & COMBOS
// ============================================

model CardSynergy {
  id         String   @id @default(cuid())
  cardId     String
  synergyId  String   // Another card's ID
  score      Float    // Synergy score (0-100)
  source     String   // "edhrec", "analysis"
  commander  String?  // Which commander context
  createdAt  DateTime @default(now())

  card Card @relation("CardSynergies", fields: [cardId], references: [id])

  @@unique([cardId, synergyId, commander])
  @@index([cardId])
  @@index([score])
}

model Combo {
  id          String      @id @default(cuid())
  name        String
  description String
  colors      String      // JSON array
  steps       String      // JSON array of steps
  result      String      // What the combo does
  popularity  Int         @default(0)
  source      String      // "edhrec", "commanderspellbook"
  sourceUrl   String?
  createdAt   DateTime    @default(now())

  cards ComboCard[]

  @@index([colors])
}

model ComboCard {
  id        String @id @default(cuid())
  comboId   String
  cardId    String
  quantity  Int    @default(1)

  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id])

  @@unique([comboId, cardId])
}

// ============================================
// SCRAPING METADATA
// ============================================

model ScrapeJob {
  id          String   @id @default(cuid())
  jobType     String   // "scryfall", "edhrec", "mtgtop8", "moxfield"
  status      String   // "pending", "running", "completed", "failed"
  itemsScraped Int     @default(0)
  errors      String?  // JSON array of errors
  startedAt   DateTime @default(now())
  completedAt DateTime?
  duration    Int?     // milliseconds

  @@index([jobType])
  @@index([status])
}

// ============================================
// USER FEEDBACK
// ============================================

model Feedback {
  id        String   @id @default(cuid())
  userId    String?  // Optional - can be anonymous
  email     String?  // Optional - for follow-up
  type      FeedbackType @default(GENERAL)
  message   String
  page      String?  // Which page the feedback was from
  createdAt DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])
  
  @@index([type])
  @@index([createdAt])
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
  DECK_ISSUE
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

