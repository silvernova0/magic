# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.cache/

# next.js
/.next/
/out/

# production
/build
.next/standalone
.next/static

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite database files
/prisma/dev.db*
/prisma/*.db
/prisma/*.db-wal
/prisma/*.db-shm

# MTGJson and training data files
/data/mtgjson/*.json
/data/mtgjson/AllDeckFiles/
/data/mtgjson/AllSetFiles/
/data/training/

# AI models
/models/

